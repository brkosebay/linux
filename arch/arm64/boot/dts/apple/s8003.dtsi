/*
 * Apple S8003 "A9" (TSMC) SoC
 *
 * Other names: H8P, "Malta"
 *
 * Copyright (c) 2024, Nick Chan <towinchenmi@gmail.com>
 */

#include "s800-0-3.dtsi"

/ {
	twister_opp: opp-table {
		compatible = "operating-points-v2";

		opp01 {
			opp-hz = /bits/ 64 <300000000>;
			opp-level = <1>;
			clock-latency-ns = <500>;
		};
		opp02 {
			opp-hz = /bits/ 64 <396000000>;
			opp-level = <2>;
			clock-latency-ns = <45000>;
		};
		opp03 {
			opp-hz = /bits/ 64 <600000000>;
			opp-level = <3>;
			clock-latency-ns = <22000>;
		};
		opp04 {
			opp-hz = /bits/ 64 <912000000>;
			opp-level = <4>;
			clock-latency-ns = <25000>;
		};
		opp05 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-level = <5>;
			clock-latency-ns = <28000>;
		};
		opp06 {
			opp-hz = /bits/ 64 <1512000000>;
			opp-level = <6>;
			clock-latency-ns = <35000>;
		};
		opp07 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-level = <7>;
			clock-latency-ns = <38000>;
		};
#if 0
		/* Not available until CPU deep sleep is implemented */
		opp08 {
			opp-hz = /bits/ 64 <1844000000>;
			opp-level = <8>;
			clock-latency-ns = <38000>;
			turbo-mode;
		};
#endif
	};
};

&{/soc} {
	/*
	 * The TSMC part has the same PCIe PHY ("phy-ip" block) as T8010; the
	 * Samsung S8000 apcie has no phy-ip region and is not described yet.
	 */
	pcie0: pcie@610000000 {
		compatible = "apple,s8003-pcie";
		device_type = "pci";

		reg = <0x6 0x10000000 0x0 0x1000000>,
		      <0x6 0x00000000 0x0 0x8000>,
		      <0x6 0x00008000 0x0 0x4000>,
		      <0x6 0x0a000000 0x0 0x40000>,
		      <0x6 0x01000000 0x0 0x4000>,
		      <0x6 0x02000000 0x0 0x4000>,
		      <0x6 0x03000000 0x0 0x4000>,
		      <0x6 0x04000000 0x0 0x4000>,
		      <0x6 0x01004000 0x0 0x4000>;
		reg-names = "config", "rc", "phy", "phy-ip",
			    "port0", "port1", "port2", "port3",
			    "nvmmu";

		interrupt-parent = <&aic>;
		interrupts = <AIC_IRQ 244 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 247 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 250 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 253 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 246 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "port0", "port1", "port2", "port3",
				  "nvmmu";

		msi-controller;
		msi-parent = <&pcie0>;
		msi-ranges = <&aic AIC_IRQ 256 IRQ_TYPE_EDGE_RISING 32>;
		apple,msi-doorbell = <0xbffff000>;
		apple,nvmmu-iova = <0xbc000000>;

		/*
		 * Root-complex inbound windows: 0x40000000 NVMMU FlatDMA,
		 * 0x80000000 DART (ADT vm-offset/vm-size), 0xbc000000 NVMMU
		 * SART, 0xbffff000 MSI. The DARTs' apple,dma-range keeps IOVAs
		 * inside the DART window. No dma-ranges here: one that ends
		 * below RAM empties ZONE_DMA/DMA32 (no CMA, no swiotlb).
		 */
		iommu-map = <0x100 &pcie0_dart0 0 1>,
			    <0x200 &pcie0_dart1 0 1>;
		iommu-map-mask = <0xff00>;

		#address-cells = <3>;
		#size-cells = <2>;
		#interrupt-cells = <1>;
		interrupt-controller;
		bus-range = <0x00 0x0f>;
		ranges = <0x03000000 0x0 0xc0000000
			  0x7 0xc0000000 0x0 0x40000000>;

		clocks = <&clkref>, <&clkref>, <&clkref>;
		clock-names = "core", "aux", "ref";
		/* ADT apcie clock-gates 57-62: pcie, pcie_aux, pcie_link0..3 */
		power-domains = <&ps_pcie>, <&ps_pcie_aux>, <&ps_pcie_ref>,
				<&ps_pcie_link0>, <&ps_pcie_link1>,
				<&ps_pcie_link2>, <&ps_pcie_link3>;
		power-domain-names = "core", "aux", "ref", "link0", "link1",
				     "link2", "link3";

		/*
		 * Tunables iBoot puts in the live ADT (apcie-phy-tunables,
		 * apcie-common-tunables; per bridge apcie-config-tunables and
		 * pcie-rc-tunables), as <offset mask value>. Copied from the
		 * j71t live ADT (iOS 16.7.10 iBoot); both bridges carry the same
		 * values there.
		 */
		apple,tunable-phy = <0x098 0x0000000f 0x00000000>,
		                    <0x154 0x00f8ff00 0x00000000>,
		                    <0x000 0x0000318c 0x00002108>,
		                    <0x004 0x0000318c 0x00002108>;
		apple,tunable-common = <0x008 0x7f7f7f7f 0x00000000>,
		                       <0x00c 0x00073f3f 0x00043f00>,
		                       <0x010 0x00000700 0x00000000>,
		                       <0x018 0x00ffffff 0x000c0960>,
		                       <0x01c 0x00001fff 0x0000092c>,
		                       <0x028 0xffffffff 0x02001000>,
		                       <0x030 0x000000ff 0x00000009>,
		                       <0x100 0x31100010 0x01000010>,
		                       <0x104 0x00000011 0x00000001>,
		                       <0x108 0x00000007 0x00000000>,
		                       <0x10c 0x00073f3f 0x00043f00>,
		                       <0x110 0x0333003f 0x0111000f>,
		                       <0x120 0x000000ff 0x00000040>,
		                       <0x128 0x0000007f 0x0000003e>,
		                       <0x130 0x00000707 0x00000000>,
		                       <0x134 0x00073f3f 0x00043f00>,
		                       <0x180 0x31100010 0x01000000>,
		                       <0x190 0x0333003f 0x0111000f>,
		                       <0x1a0 0x000000ff 0x00000040>,
		                       <0x1a8 0x0000007f 0x0000003e>,
		                       <0x1b0 0x00000707 0x00000000>,
		                       <0x1b4 0x00073f3f 0x00043f00>,
		                       <0x200 0x31100010 0x01000000>,
		                       <0x210 0x0333003f 0x0111000f>,
		                       <0x220 0x000000ff 0x00000040>,
		                       <0x228 0x0000007f 0x0000003e>,
		                       <0x230 0x00000707 0x00000000>,
		                       <0x234 0x00073f3f 0x00043f00>,
		                       <0x280 0x31100010 0x01000000>,
		                       <0x290 0x0333003f 0x0111000f>,
		                       <0x2a0 0x000000ff 0x00000040>,
		                       <0x2a8 0x0000007f 0x0000003e>,
		                       <0x2b0 0x00000707 0x00000000>,
		                       <0x2b4 0x00073f3f 0x00043f00>;
		status = "disabled";

		/*
		 * PERST# from the j71t/j72t ADT pci-bridge0/1 function-perst.
		 * CLKREQ# (GPIO 164/165) stays in its peripheral function:
		 * iOS never waits on it here (no clkreq-wait-time).
		 */
		pcie0_port0: pci@0,0 {
			device_type = "pci";
			reg = <0x0 0x0 0x0 0x0 0x0>;
			reset-gpios = <&pinctrl_ap 160 GPIO_ACTIVE_LOW>;
			max-link-speed = <2>;
			apple,nvme-mode;
			/*
			 * Linux would enable ASPM L1 on its own on DT platforms;
			 * iOS pairs L1 with L1SS/LTR/CLKREQ# setup we don't do.
			 */
			aspm-no-l0s;
			aspm-no-l1;
			apple,tunable-config = <0x090 0x000000ff 0x00000028>,
			                       <0x130 0x00000005 0x00000005>,
			                       <0x134 0x00000001 0x00000001>,
			                       <0x138 0x00007f7f 0x00000000>,
			                       <0x13c 0x00000003 0x00000002>,
			                       <0x140 0x0073ffff 0x00704c4b>;
			apple,tunable-rc = <0x098 0x0000000f 0x00000000>,
			                   <0x154 0x00f8ff00 0x00000000>;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
		};

		pcie0_port1: pci@1,0 {
			device_type = "pci";
			reg = <0x800 0x0 0x0 0x0 0x0>;
			reset-gpios = <&pinctrl_ap 161 GPIO_ACTIVE_LOW>;
			max-link-speed = <1>;
			aspm-no-l0s;
			aspm-no-l1;
			apple,tunable-config = <0x090 0x000000ff 0x00000028>,
			                       <0x130 0x00000005 0x00000005>,
			                       <0x134 0x00000001 0x00000001>,
			                       <0x138 0x00007f7f 0x00000000>,
			                       <0x13c 0x00000003 0x00000002>,
			                       <0x140 0x0073ffff 0x00704c4b>;
			apple,tunable-rc = <0x098 0x0000000f 0x00000000>,
			                   <0x154 0x00f8ff00 0x00000000>;

			#address-cells = <3>;
			#size-cells = <2>;
			ranges;
		};
	};
};

/*
 * The A9 was made by two separate fabs on two different process
 * nodes: Samsung made the S8000 (APL0898) on 14nm and TSMC made
 * the S8003 (APL1022) on 16nm. There are some minor differences
 * such as timing in cpufreq state transistions.
 */

/* j71t ADT: two GPU windows; explicitly activated diagnostic only. */
&{/soc} {
	gpu_diag: gpu@201000000 {
		compatible = "gpu,s8003";
		reg = <0x2 0x01000000 0x0 0x100000>,
		      <0x2 0x01e00000 0x0 0x100000>;
		reg-names = "rgx", "fender";
		power-domains = <&ps_gfx>;
		interrupts = <AIC_IRQ 170 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 171 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 172 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 173 IRQ_TYPE_LEVEL_HIGH>,
			     <AIC_IRQ 174 IRQ_TYPE_LEVEL_HIGH>;
	};
};
